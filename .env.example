# TeamUP Environment Variables Template
# Rename this file to .env and fill in your actual keys.

# Server Port (Default is 5000)
PORT=5000

# ----------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB Atlas)
# ----------------------------------------------------------------------
# For persistent cloud storage (Required on Render/Vercel):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# JWT Secret for authenticating users
JWT_SECRET=teamup_jwt_secret_2026_super_secure

# ----------------------------------------------------------------------
# EMAIL CONFIGURATION (For Registration OTP & Password Reset)
# ----------------------------------------------------------------------
# Option A: Resend API (Recommended for Render/Cloud - Free 3,000 emails/month)
# Get your free key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Option B: Gmail SMTP (Requires App Password from Google Account)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM=TeamUP <your_email@gmail.com>

# ----------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# ----------------------------------------------------------------------
# Leave as mock keys to test without spending real money, or paste Razorpay live keys:
RAZORPAY_KEY_ID=mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret
