# TeamUP Environment Variables Template
# Rename this file to .env and fill in your actual keys.

# Server Port (Default is 5000)
PORT=5000

# ----------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB)
# ----------------------------------------------------------------------
# By default, TeamUP uses a local JSON fallback if MongoDB is not available.
# To use a real database, start a MongoDB instance and set this URI:
MONGO_URI=mongodb://127.0.0.1:27017/teamup_db

# JWT Secret for authenticating users
JWT_SECRET=super_secret_teamup_jwt_key_2026_change_me

# ----------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# ----------------------------------------------------------------------
# If you leave these as "mock_key_id", the app simulates successful payments 
# instantly (great for testing the UI without spending money).
# 
# To accept real payments:
# 1. Sign up at https://razorpay.com
# 2. Get your test/live API keys from your dashboard
# 3. Paste them below:
RAZORPAY_KEY_ID=mock_key_id
RAZORPAY_KEY_SECRET=mock_key_secret
